# ShepardOne — staging / VPS "dev" stack env
# Place on the VPS as: /var/www/dev/.env.dev
#
#   cp .env.dev.example /var/www/dev/.env.dev
#
# This is NOT local laptop Docker (.env.docker). It is the server-side
# staging environment that shares the VPS with production.

# ---- Compose isolation (must differ from prod) ----
COMPOSE_PROJECT_NAME=shepardone-dev

# ---- Images (same GHCR images as prod; tag may track develop) ----
APP_IMAGE=ghcr.io/OWNER/shepard-one
NGINX_IMAGE=ghcr.io/OWNER/shepard-one-nginx
IMAGE_TAG=latest

# Different host port so both stacks can run together
HTTP_PORT=127.0.0.1:8081

APP_NAME=ShepardOne Dev
APP_ENV=staging
APP_KEY=base64:GENERATE_A_DIFFERENT_KEY_FROM_PROD
APP_DEBUG=true
APP_URL=https://dev.your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shepardone_dev
DB_USERNAME=shepard
DB_PASSWORD=change-me-strong-dev-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-dev-root-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@dev.your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
TRUSTED_PROXIES=*

RUN_MIGRATIONS=false
RUN_OPTIMIZE=true

HYBRID_APP_ID=church.shepardone.app
HYBRID_APP_NAME=ShepardOne
HYBRID_API_VERSION=1
HYBRID_REQUIRE_HTTPS=true
HYBRID_ACCESS_TOKEN_TTL=60
HYBRID_REFRESH_TOKEN_TTL_DAYS=30
HYBRID_MAX_DEVICES=10
VITE_API_BASE_URL=
VITE_API_VERSION=1
VITE_HYBRID_REQUIRE_HTTPS=true
