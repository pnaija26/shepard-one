        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/cli": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "@capacitor/ios": "^8.5.0",
        "@capacitor/network": "^8.0.1",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3",
        "@lucide/vue": "^1.31.0",
        "axios": "^1.19.0",
