{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "hybrid:build": "vite build --config vite.hybrid.config.js",
        "hybrid:sync": "npm run hybrid:build && npx cap sync",
        "hybrid:android": "npm run hybrid:sync && npx cap open android",
        "hybrid:ios": "npm run hybrid:sync && npx cap open ios"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.3",
