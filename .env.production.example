# ShepardOne — production stack env
# Place on the VPS as: /var/www/prod/.env.production
#
#   cp .env.production.example /var/www/prod/.env.production

# ---- Compose isolation (required when running with /var/www/dev) ----
COMPOSE_PROJECT_NAME=shepardone-prod

# ---- Images (lowercase GitHub owner/repo) ----
APP_IMAGE=ghcr.io/OWNER/shepard-one
NGINX_IMAGE=ghcr.io/OWNER/shepard-one-nginx
IMAGE_TAG=latest

# Bind to localhost; host nginx terminates TLS and proxies here
HTTP_PORT=127.0.0.1:8080

APP_NAME=ShepardOne
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shepardone
DB_USERNAME=shepard
DB_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
TRUSTED_PROXIES=*

RUN_MIGRATIONS=false
RUN_OPTIMIZE=true

HYBRID_APP_ID=church.shepardone.app
HYBRID_APP_NAME=ShepardOne
HYBRID_API_VERSION=1
HYBRID_REQUIRE_HTTPS=true
HYBRID_ACCESS_TOKEN_TTL=60
HYBRID_REFRESH_TOKEN_TTL_DAYS=30
HYBRID_MAX_DEVICES=10
VITE_API_BASE_URL=
VITE_API_VERSION=1
VITE_HYBRID_REQUIRE_HTTPS=true
