# Story 12.1 — hybrid / Capacitor environment (never commit real secrets)
# Copy to .env.mobile and load before `npm run hybrid:sync` / store builds.

HYBRID_APP_ID=church.shepardone.app
HYBRID_APP_NAME=ShepardOne

# Live-reload against local Laravel (omit for release bundles)
# CAPACITOR_SERVER_URL=http://10.0.2.2:8000
# CAPACITOR_CLEARTEXT=true

# Production API (HTTPS required outside localhost)
VITE_API_BASE_URL=https://api.example.church/api
VITE_API_VERSION=1
VITE_HYBRID_REQUIRE_HTTPS=true

# Android signing (paths only — keep keystore files outside git)
# ANDROID_KEYSTORE_PATH=/secure/path/shepardone-release.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# iOS signing is managed in Xcode / CI secrets — do not commit profiles or .p12 files
