# Convenience alias for local Docker Bring-up
# Prefer `.env.production.example` for VPS; this file mirrors compose defaults.

APP_IMAGE=shepardone-app
NGINX_IMAGE=shepardone-nginx
IMAGE_TAG=dev
HTTP_PORT=8080

APP_NAME=ShepardOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shepardone
DB_USERNAME=shepard
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

REDIS_HOST=redis
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

RUN_MIGRATIONS=true
RUN_OPTIMIZE=false
LOG_LEVEL=debug
TRUSTED_PROXIES=*
